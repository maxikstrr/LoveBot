OWNER_NUMBER=4915155894714
OWNER_PASSWORD=change-this-locally
PORT=7777
HOST=0.0.0.0
# Nur true setzen, wenn ein vertrauenswürdiger Reverse Proxy davorsteht.
TRUST_PROXY=false
# 🔑 ADMIN-PASSWORT (Master): getrennt vom Login-Passwort, gilt für Downloads/Exporte
# und Step-up-Bestätigung kritischer Aktionen. Ohne Eintrag = Fallback auf OWNER_PASSWORD.
ADMIN_PASSWORD=

# 🔐 DATEI-LOGIN beim ÖFFNEN der Downloads (automatisch, kein Office nötig):
# Passwort hier eintragen = JEDE heruntergeladene Office-Datei (Brand-Datei,
# Live-Excel und jede Office-Datei in der All-in-One-ZIP) wird verschlüsselt.
# Beim Öffnen fragt Excel/Word/PowerPoint dann selbst nach dem Passwort —
# auf jedem Gerät, ohne Makro, ohne „Inhalt aktivieren“.
# Benutzername kann eine verschlüsselte Datei technisch NICHT abfragen
# (Benutzername+Passwort geht nur über das Makro-Login, siehe Schutz/).
# Voraussetzung auf dem Server: python3 + `pip install msoffcrypto-tool pycryptodome`
DATEI_LOGIN_PW=
DATEI_LOGIN_USER=Maxichen
